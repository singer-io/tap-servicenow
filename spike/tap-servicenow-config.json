{
  "tap_name": "ServiceNow",
  "required_config_keys": ["instance", "user", "password"],
  "page_size": 100,
  "pagination_key": "sysparm_offset",
  "next_page_strategy": "increment_by_results_count",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "auth_type": "basic",
