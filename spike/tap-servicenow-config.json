    "instance": "instance",
    "user": "user",
    "password": "password"
  },
  "base_url": "https://{instance}.service-now.com/api/now/",
  "streams": [],
  "author": "Stitch",
  "third_party_dependencies": [
    "singer-python==6.1.1",
    "requests==2.32.4",
    "backoff==2.2.1"
  ]
}
